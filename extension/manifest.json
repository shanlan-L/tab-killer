{
  "manifest_version": 3,
  "name": "Tab Killer",
  "version": "1.0.0",
  "description": "Keep tabs on your tabs. Tab Killer turns your new tab page into a clear dashboard for grouped tabs and fast cleanup.",
  "permissions": ["tabs", "storage", "favicon", "tabGroups"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Tab Killer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
