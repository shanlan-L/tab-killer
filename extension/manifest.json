{
  "manifest_version": 3,
  "name": "Tab Killer",
  "version": "1.1.0",
  "minimum_chrome_version": "121",
  "description": "Keep tabs on your tabs. Tab Killer turns your new tab page into a ledger of open tabs, sorted by when you last used them, with a place to park what you are not using.",
  "permissions": ["tabs", "storage", "favicon", "tabGroups"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Park this window (Tab Killer)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Park this window"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
